<% if @taxonomy.is_a?(Organization) %>

  <%# Label is a Katello/Candlepin identifier, not a Foreman taxonomy attribute. %>
  <%= javascript_include_tag 'katello/organizations/label_from_name' %>
  <%= text_f f, :label, :class => 'input-xlarge',
             :help_inline => _('Generated from the name. Cannot be changed later.') %>

<% end %>
